# ---------------------------------------------------------------------------
# Provider credentials for the "Ask my portfolio" agent.
#
# ⚠️ These are read ONLY by api/chat.ts (a serverless function). They must
# NEVER be prefixed with VITE_ and never imported from src/ — anything Vite
# can see ends up in the public bundle in plaintext.
#
# Set them in the Vercel dashboard (Project → Settings → Environment Variables),
# not in a committed file. This file documents the names only.
# ---------------------------------------------------------------------------

# --- Tier 1: Databricks Model Serving ---
# All three are required; the token alone is not usable.
#   HOST     — your workspace URL, no trailing slash
#   ENDPOINT — exact name from the workspace's "Serving" page
#   CLIENT_ID / CLIENT_SECRET — OAuth credentials for a dedicated service
#              principal with CAN_QUERY on this serving endpoint only.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_ENDPOINT=databricks-claude-sonnet-4-5
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# --- Tier 2: OpenRouter (automatic fallback, free models) ---
# Used when Databricks errors, times out, or hits quota. The function fetches
# the live list of zero-price models rather than hardcoding ids, because free
# tier ids get renamed and retired regularly.
OPENROUTER_API_KEY=

# Tier 3 (scripted answers) needs no credentials — see src/lib/fallback.ts.

# --- Contact form (exposed to the browser by design) ---
# Create a key at Web3Forms and restrict delivery to your chosen inbox.
# Set this in Vercel; never put a real value in this committed example.
VITE_WEB3FORMS_KEY=

# Optional comma-separated extra origins accepted by /api/chat.
# The canonical site and localhost development origins are allowed automatically.
CHAT_ALLOWED_ORIGINS=
